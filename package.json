{
  "name": "aurelia-joyeria",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace @aurelia/web run dev",
    "build": "npm --workspace @aurelia/web run build",
    "test": "npm --workspace @aurelia/web test",
    "lint": "npm --workspace @aurelia/web run lint",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,json,yml}\" \"*.json\" \"README.md\" \"docs/*.md\"",
    "format:check": "prettier --check \"apps/web/**/*.{ts,tsx,css,json,yml}\" \"*.json\" \"README.md\" \"docs/*.md\""
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
